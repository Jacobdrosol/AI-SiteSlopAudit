{
  "name": "slopaudit",
  "version": "0.1.0",
  "description": "Deterministic auditor for AI-generated slop in websites, apps and codebases.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "slopaudit": "./bin/slopaudit.mjs"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "audit": "tsx src/cli.ts audit",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "files": [
    "src",
    "bin",
    "rubric",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
